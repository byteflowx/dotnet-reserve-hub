@host = http://localhost:5080
@roomAlphaId = 11111111-1111-1111-1111-111111111111
@bookingId = 00000000-0000-0000-0000-000000000000

###
GET {{host}}/api/resources?type=Room&minCapacity=4

###
GET {{host}}/api/resources/{{roomAlphaId}}/availability?start=2030-01-01T10:00:00Z&end=2030-01-01T12:00:00Z

###
POST {{host}}/api/bookings
Content-Type: application/json

{
  "resourceId": "{{roomAlphaId}}",
  "bookedBy": "Anna",
  "start": "2030-01-01T10:00:00Z",
  "end": "2030-01-01T11:00:00Z"
}

###
POST {{host}}/api/bookings
Content-Type: application/json

{
  "resourceId": "{{roomAlphaId}}",
  "bookedBy": "Bohdan",
  "start": "2030-01-01T10:30:00Z",
  "end": "2030-01-01T11:30:00Z"
}

###
GET {{host}}/api/bookings/{{bookingId}}

###
POST {{host}}/api/bookings/{{bookingId}}/cancel

###
POST {{host}}/api/bookings
Content-Type: application/json

{
  "resourceId": "{{roomAlphaId}}",
  "bookedBy": "Anna",
  "start": "2030-01-01T12:00:00Z",
  "end": "2030-01-01T11:00:00Z"
}
